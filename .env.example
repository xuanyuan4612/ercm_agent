# 赫尔墨斯（Hermes）环境变量模板
# 复制为 .env 并填写实际值

# 应用
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 服务器
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# 数据库 (PostgreSQL 16 + pgvector)
DB_HOST_WRITE=localhost
DB_HOST_READ=localhost
DB_PORT=5432
DB_NAME=hermes
DB_USER=hermes
DB_PASSWORD=hermes
DB_POOL_SIZE=20

# Redis
REDIS_CLUSTER_NODES=redis://localhost:6379/0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch
ES_HOSTS=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hermes

# LLM (DeepSeek)
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-v4-pro

# LLM Backup (通义千问)
LLM_BACKUP_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BACKUP_API_KEY=sk-your-backup-key
LLM_BACKUP_MODEL=qwen3.7-plus

# Embedding
EMBEDDING_API_BASE=https://api.lingyaai.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_MODEL=text-embedding-3-large

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_SECONDS=28800
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# AES-256-GCM 加密密钥 (32字节 Base64 编码)
ENCRYPTION_KEY=

# 可观测性 (可选)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# JAEGER_HOST=localhost
